              "pm.test('All returned doctors are active', () => {",
              "  pm.response.json().forEach(d => pm.expect(d.active ?? d.isActive).to.be.true);",
              "});"
            ]}
          }]
        },

        {
          "name": "GET /doctors/1 — by seeded ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/doctors/1", "host": ["{{base_url}}"], "path": ["doctors","1"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Has name', () => pm.expect(pm.response.json().name).to.be.a('string'));",
              "pm.test('Has consultationFee', () => pm.expect(pm.response.json().consultationFee).to.exist);",
              "pm.test('Has specializationName', () => pm.expect(pm.response.json().specializationName).to.be.a('string'));"
            ]}
          }]
        },

        {
          "name": "GET /doctors/9999 — not found → 404",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/doctors/9999", "host": ["{{base_url}}"], "path": ["doctors","9999"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
            ]}
          }]
        }

      ]
    },

    {
