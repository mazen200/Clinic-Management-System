              "if (pm.response.code === 200) {",
              "  pm.test('Body is array', () => pm.expect(pm.response.json()).to.be.an('array'));",
              "  pm.test('Each schedule has id, dayOfWeek, startTime, endTime, doctor', () => {",
              "    pm.response.json().forEach(s => {",
              "      pm.expect(s).to.have.property('id');",
              "      pm.expect(s).to.have.property('dayOfWeek');",
              "      pm.expect(s).to.have.property('startTime');",
              "      pm.expect(s).to.have.property('endTime');",
              "      pm.expect(s).to.have.property('doctor');",
              "    });",
              "  });",
              "  const first = pm.response.json()[0];",
