{
  "info": {
    "name": "Clinic Management System — Full API Tests",
    "_postman_id": "clinic-full-v2",
    "description": "Complete test suite. Run in order using Collection Runner after seeding the DB.\n\nBase URL: http://localhost:8080\n\nVariables auto-captured from responses:\n  created_spec_id, created_patient_id, created_schedule_id, doctor_id",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",           "value": "http://localhost:8080" },
    { "key": "created_spec_id",    "value": "" },
    { "key": "created_patient_id", "value": "" },
    { "key": "created_schedule_id","value": "" },
    { "key": "doctor_id",          "value": "1" },
    { "key": "seeded_patient_id",  "value": "1" },
    { "key": "seeded_schedule_id", "value": "1" }
  ],
  "item": [

    {
      "name": "🟢 1 — Specializations",
      "item": [

        {
          "name": "GET /spec — returns list",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/spec", "host": ["{{base_url}}"], "path": ["spec"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Body is array', () => pm.expect(pm.response.json()).to.be.an('array'));",
              "pm.test('Array is not empty (seed required)', () => pm.expect(pm.response.json().length).to.be.above(0));",
              "pm.test('Each item has id, name, description', () => {",
              "  pm.response.json().forEach(s => {",
              "    pm.expect(s).to.have.all.keys('id','name','description');",
              "    pm.expect(s.id).to.be.a('number');",
              "    pm.expect(s.name).to.be.a('string').and.not.empty;",
              "  });",
              "});"
            ]}
          }]
        },

        {
          "name": "POST /spec — create Oncology",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/spec", "host": ["{{base_url}}"], "path": ["spec"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Oncology\",\n  \"description\": \"Diagnosis and treatment of cancer\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Response has id', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b.id).to.be.a('number');",
              "  pm.collectionVariables.set('created_spec_id', b.id);",
              "});",
              "pm.test('Name matches request', () => pm.expect(pm.response.json().name).to.eql('Oncology'));",
              "pm.test('Description matches request', () => pm.expect(pm.response.json().description).to.eql('Diagnosis and treatment of cancer'));"
            ]}
          }]
        },

        {
          "name": "POST /spec — empty name (edge case)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/spec", "host": ["{{base_url}}"], "path": ["spec"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"description\": \"No name provided\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Server responds (2xx or 4xx — document actual behavior)', () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([201, 400, 422]);",
              "});"
            ]}
          }]
        },

        {
          "name": "GET /spec — verify Oncology was persisted",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/spec", "host": ["{{base_url}}"], "path": ["spec"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Oncology exists in list', () => {",
              "  const list = pm.response.json();",
              "  const found = list.find(s => s.name === 'Oncology');",
              "  pm.expect(found).to.not.be.undefined;",
              "});"
            ]}
          }]
        }

      ]
    },

    {
