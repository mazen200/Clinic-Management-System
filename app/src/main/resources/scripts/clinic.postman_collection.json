              "});",
              "const first = pm.response.json()[0];",
              "if (first) pm.collectionVariables.set('doctor_id', first.id ?? pm.collectionVariables.get('doctor_id'));"
            ]}
          }]
        },

        {
          "name": "GET /doctors?active=true&specId=1 — filtered",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/doctors?active=true&specId=1",
              "host": ["{{base_url}}"], "path": ["doctors"],
              "query": [{ "key": "active", "value": "true" }, { "key": "specId", "value": "1" }]
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
